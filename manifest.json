{
  "manifest_version": 3,
  "name": "PageWand",
  "version": "1.0.0",
  "description": "A lightweight browser toolkit for shaping any webpage",
  "permissions": [
    "activeTab",
    "scripting",
    "clipboardWrite",
    "downloads"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "PageWand - Click to activate"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+Z"
      },
      "description": "Start or stop PageWand"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
